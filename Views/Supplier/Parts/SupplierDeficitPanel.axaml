<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="1020"
    d:DesignHeight="730"
    x:Class="FenceFactory.Desktop.Views.Supplier.Parts.SupplierDeficitPanel">

    <Grid
        RowDefinitions="Auto, *"
        Margin="20">

        <!-- ИНФОРМАЦИОННАЯ СВОДКА ПЛАНОВОГО ДЕФИЦИТА -->
        <Border
            Grid.Row="0"
            Background="#1E1E24"
            CornerRadius="5"
            Padding="15"
            Margin="0,0,0,15">
            <StackPanel
                Spacing="5">
                <TextBlock
                    Text="БАЛАНС МАТЕРИАЛЬНОГО ОБЕСПЕЧЕНИЯ ПРОИЗВОДСТВА"
                    FontSize="14"
                    Foreground="#2A5C91"
                    FontWeight="Bold" />
                <TextBlock
                    Text="Сводный аналитический отчет для планового закупа. Показывает объемы ТМЦ, требуемые для полного закрытия текущего портфеля заказов."
                    FontSize="11"
                    Foreground="#8A8A93" />
            </StackPanel>
        </Border>

        <!-- ТАБЛИЦА ПЛАНОВОЙ ПОТРЕБНОСТИ -->
        <Border
            Grid.Row="1"
            Background="#1E1E24"
            CornerRadius="5"
            Padding="10">
            <Grid
                RowDefinitions="Auto, *">
                <TextBlock
                    Grid.Row="0"
                    Text=" ПОТРЕБНОСТЬ В МАТЕРИАЛАХ (К ЗАГРУЗКЕ В ОРДЕР ПОСТАВЩИКА)"
                    FontSize="11"
                    Foreground="#8A8A93"
                    FontWeight="Bold"
                    Margin="5,5,5,10" />

                <DataGrid
                    Grid.Row="1"
                    x:Name="DeficitDataGrid"
                    x:CompileBindings="False"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="All"
                    BorderThickness="1"
                    BorderBrush="#2D2D35">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Код ТМЦ"
                            Width="100"
                            Binding="{Binding MaterialId}" />
                        <DataGridTextColumn
                            Header="Наименование / Параметры по номенклатуре"
                            Width="*"
                            Binding="{Binding MaterialName}" />
                        <DataGridTextColumn
                            Header="Общая потребность по плану (шт/м)"
                            Width="220"
                            Binding="{Binding TotalRequired}" />
                        <DataGridTextColumn
                            Header="Текущий остаток (Свободный склад)"
                            Width="200"
                            Binding="{Binding AvailableStock}" />
                        <DataGridTextColumn
                            Header="Требуется докупить (План закупа)"
                            Width="200"
                            Binding="{Binding DeficitAmount}"
                            Foreground="#FFFFFF" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>