<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="FenceFactory.Desktop.Views.Supplier.Parts.SupplierMenuPart">

    <DockPanel>
        <!-- Кнопка Выхода (всегда внизу меню) -->
        <Button
            Classes="exit-btn"
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <TextBlock
                Classes="buton-exit-text"
                Text="ВЫХОД СИСТЕМЫ" />
        </Button>

        <!-- 2 монолитные кнопки управления закупками и складом -->
        <StackPanel
            Spacing="10"
            VerticalAlignment="Top">

            <!-- Кнопка шага 7.0.8 (Дефицит) -->
            <Button
                Classes="menu-btn active"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <TextBlock
                    Classes="buton-text"
                    Text="[ ] НЕХВАТКА МАТЕРИАЛОВ" />
            </Button>

            <!-- Кнопка шага 7.0.9 (Оформление прихода) -->
            <Button
                Classes="menu-btn"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <TextBlock
                    Classes="buton-text"
                    Text="[ ] ОФОРМЛЕНИЕ ПРИХОДА" />
            </Button>

        </StackPanel>

    </DockPanel>
</UserControl>