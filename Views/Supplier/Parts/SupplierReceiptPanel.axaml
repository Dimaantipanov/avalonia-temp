<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1020"
    d:DesignHeight="730"
    x:Class="FenceFactory.Desktop.Views.Supplier.Parts.SupplierReceiptPanel">

       <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <!-- ЗОНА 1: ИНСТРУМЕНТ ВВОДА ПОЗИЦИЙ ИЗ НАКЛАДНОЙ -->
        <Border Grid.Row="0" Background="#1E1E24" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*, 150, Auto" RowDefinitions="Auto, Auto">
                
                <!-- Заголовки полей -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="МАТЕРИАЛ ПО НОМЕНКЛАТУРЕ" FontSize="11" Foreground="#8A8A93" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="КОЛИЧЕСТВО" FontSize="11" Foreground="#8A8A93" FontWeight="Bold" Margin="10,0,0,5"/>
                
                <!-- Элементы ввода -->
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="ReceiptMaterialComboBox" HorizontalAlignment="Stretch" Height="40" PlaceholderText="Выберите материал для оприходования..."/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ReceiptAmountTextBox" Height="40" Margin="10,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Watermark="0"/>
                
                <Button Grid.Row="1" Grid.Column="2" x:Name="AddReceiptItemButton" Content="ДОБАВИТЬ В СПИСОК" Background="#2A5C91" Foreground="White" Height="40" Padding="20,0" Margin="15,0,0,0" VerticalContentAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- ЗОНА 2: ТАБЛИЦА ТЕКУЩЕЙ ПРИЕМКИ -->
        <Border Grid.Row="1" Background="#1E1E24" CornerRadius="5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="ПРИНИМАЕМЫЙ МАТЕРИАЛ (ТЕКУЩАЯ ПОСТАВКА)" FontSize="11" Foreground="#8A8A93" FontWeight="Bold" Margin="5,5,5,10"/>
                
                <DataGrid Grid.Row="1" x:Name="ReceiptDataGrid" x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#2D2D35">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование материала" Width="*" Binding="{Binding MaterialName}"/>
                        <DataGridTextColumn Header="Количество (шт/м)" Width="150" Binding="{Binding Amount}"/>
                        
                        <!-- Удаление ошибочно введенной строки до отправки в базу -->
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить" Background="#963232" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ЗОНА 3: ОТПРАВКА НА СКЛАД -->
        <Button Grid.Row="2" x:Name="SubmitReceiptButton" Content="ОПРИХОДОВАТЬ НА СКЛАД" Background="#2A5C91" Foreground="White" Height="50" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,15,0,0"/>

    </Grid>
</UserControl>


