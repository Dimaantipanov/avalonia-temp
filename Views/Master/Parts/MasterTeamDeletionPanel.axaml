<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="FenceFactory.Desktop.Views.Master.Parts.MasterTeamDeletionPanel">
    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <!-- ЗАГОЛОВОК И ПРАВИЛО БЕЗОПАСНОСТИ -->
        <Border Grid.Row="0" Background="#1E1E24" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel Spacing="5">
                <TextBlock Text="РАСФОРМИРОВАНИЕ И УДАЛЕНИЕ ПРОИЗВОДСТВЕННЫХ БРИГАД" FontSize="14" Foreground="#E53935" FontWeight="Bold"/>
                <TextBlock Text="Внимание: Удаление бригады возможно только в том случае, если она свободна или находится на отдыхе. Удаление занятой на объекте бригады заблокировано." FontSize="11" Foreground="#8A8A93"/>
            </StackPanel>
        </Border>

        <!-- ЖУРНАЛ БРИГАД С КНОПКАМИ ИСКЛЮЧЕНИЯ -->
        <Border Grid.Row="1" Background="#1E1E24" CornerRadius="5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="ТЕКУЩИЙ СОСТАВ ЦЕХА ДЛЯ КАДРОВОГО АУДИТА" FontSize="11" Foreground="#8A8A93" FontWeight="Bold" Margin="5,5,5,10"/>
                
                <DataGrid Grid.Row="1" x:Name="DeletionTeamsDataGrid" x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#2D2D35">
                    <DataGrid.Columns>
                        <!-- Данные бригады из бэкенд модели Brigade -->
                        <DataGridTextColumn Header="Идентификатор (ID)" Width="150" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Наименование / Номер бригады" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Текущий статус" Width="180" Binding="{Binding Status}"/>
                        
                        <!-- Колонка действия: Увольнение с учетом защиты от удаления занятых -->
                        <DataGridTemplateColumn Header="Кадровое действие" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="УВОЛИТЬ" 
                                            Background="#963232" 
                                            Foreground="White" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Padding="15,5" 
                                            FontWeight="Bold"
                                            FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
