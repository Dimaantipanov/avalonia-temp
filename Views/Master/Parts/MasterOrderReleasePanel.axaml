<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="FenceFactory.Desktop.Views.Master.Parts.MasterOrderReleasePanel">
      <Grid RowDefinitions="Auto, *" Margin="20">
        
        <!-- ЗАГОЛОВОК И ИНСТРУКЦИЯ -->
        <Border Grid.Row="0" Background="#1E1E24" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel Spacing="5">
                <TextBlock Text="ВЫДАЧА ОРДЕРОВ И НАЗНАЧЕНИЕ ПРОИЗВОДСТВЕННЫХ БРИГАД" FontSize="14" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="В журнале отображаются только полностью обеспеченные материалом заказы. Выберите свободную бригаду и закрепите её за объектом." FontSize="11" Foreground="#8A8A93"/>
            </StackPanel>
        </Border>

        <!-- ТАБЛИЦА ГОТОВЫХ ОРДЕРОВ -->
        <Border Grid.Row="1" Background="#1E1E24" CornerRadius="5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="ЖУРНАЛ ОРДЕРОВ, ГОТОВЫХ К ВЫДАЧЕ В ЦЕХ" FontSize="11" Foreground="#8A8A93" FontWeight="Bold" Margin="5,5,5,10"/>
                
                <DataGrid Grid.Row="1" x:Name="ReadyOrdersDataGrid" x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#2D2D35">
                    <DataGrid.Columns>
                        <!-- Данные ордера -->
                        <DataGridTextColumn Header="ID Ордера" Width="100" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Адрес объекта монтажа" Width="*" Binding="{Binding Address}"/>
                        
                        <!-- Колонка интерактивного выбора свободной бригады -->
                        <DataGridTemplateColumn Header="Назначить свободную бригаду" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="RowBrigadeComboBox" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,0" PlaceholderText="Выбор бригады..."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Боевая кнопка списания и фиксации ответственности Мастера -->
                        <DataGridTemplateColumn Header="Действие" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="ЗАКРЕПИТЬ И ВЫДАТЬ" 
                                            Background="#2E7D32" 
                                            Foreground="White" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Padding="15,5" 
                                            FontWeight="Bold"
                                            FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
