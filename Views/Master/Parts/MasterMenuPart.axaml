<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="FenceFactory.Desktop.Views.Master.Parts.MasterMenuPart">

    <DockPanel>
        <!-- Кнопка Выхода (всегда внизу меню) -->
        <Button
            Classes="exit-btn"
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <TextBlock
                Classes="buton-exit-text"
                Text="ВЫХОД СИСТЕМЫ" />
        </Button>

        <!-- 3 монолитные кнопки управления бригадами и заказами -->
        <StackPanel
            Spacing="10"
            VerticalAlignment="Top">

            <Button
                Classes="menu-btn active"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <TextBlock
                    Classes="buton-text"
                    Text="[ ] РЕГИСТРАЦИЯ БРИГАД" />
            </Button>

            <Button
                Classes="menu-btn"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <TextBlock
                    Classes="buton-text"
                    Text="[ ] ВЫДАЧА ОРДЕРОВ" />
            </Button>

            <Button
                Classes="menu-btn"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <TextBlock
                    Classes="buton-text"
                    Text="[ ] УДАЛЕНИЕ БРИГАД" />
            </Button>

        </StackPanel>

    </DockPanel>
</UserControl>