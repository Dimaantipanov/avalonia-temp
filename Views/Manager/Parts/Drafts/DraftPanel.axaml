<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FenceFactory.Desktop.Views.Manager.Parts.Drafts.DraftPanel">
    

    
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        
        <!-- ЗОНА 1: ШАПКА ЗАКАЗА -->
        <Border Grid.Row="0" Background="#1E1E24" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel Spacing="5">
                <TextBlock Text="АДРЕС ОБЪЕКТА ДОСТАВКИ / МОНТАЖА" FontSize="12" Foreground="#8A8A93" FontWeight="Bold"/>
                <TextBox x:Name="AddressTextBox" Watermark="Введите полный адрес (например: г. Магнитогорск, ул. Ленина, д. 10)..." Height="40" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ЗОНА 2: КОНВЕЙЕР СБОРКИ (ДОБАВЛЕНИЕ МАТЕРИАЛОВ) -->
        <Border Grid.Row="1" Background="#1E1E24" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*, 150, Auto" RowDefinitions="Auto, Auto">
                
                <!-- Заголовки полей -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ВЫБОР МАТЕРИАЛА ИЗ НОМЕНКЛАТУРЫ" FontSize="11" Foreground="#8A8A93" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="КОЛИЧЕСТВО" FontSize="11" Foreground="#8A8A93" FontWeight="Bold" Margin="10,0,0,5"/>
                
                <!-- Элементы ввода -->
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="MaterialComboBox" HorizontalAlignment="Stretch" Height="40" PlaceholderText="Выберите material из алфавита..."/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AmountTextBox" Height="40" Margin="10,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Watermark="0"/>
                
                <Button Grid.Row="1" Grid.Column="2" x:Name="AddMaterialButton" Content="ДОБАВИТЬ В СМЕТУ" Background="#2A5C91" Foreground="White" Height="40" Padding="20,0" Margin="15,0,0,0" VerticalContentAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- ЗОНА 3: ИТОГОВАЯ ТАБЛИЦА СМЕТЫ -->
        <Border Grid.Row="2" Background="#1E1E24" CornerRadius="5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="ТЕКУЩИЙ СОСТАВ ЗАКАЗА (СМЕТА)" FontSize="12" Foreground="#8A8A93" FontWeight="Bold" Margin="5,5,5,10"/>
                
                <DataGrid Grid.Row="1" x:Name="EstimateDataGrid" x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#2D2D35">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование материала / Параметры" Width="*" Binding="{Binding MaterialName}"/>
                        <DataGridTextColumn Header="Количество (шт/м)" Width="150" Binding="{Binding Amount}"/>
                        
                        <!-- Колонка для быстрого выжигания ошибочной строки -->
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить" Background="#963232" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ЗОНА 4: ФИНАЛЬНЫЙ ПУСК -->
        <StackPanel Grid.Row="3" Spacing="5" Margin="0,15,0,0">
            <!-- Статусная строка для вывода ошибок -->
            <TextBlock x:Name="ErrorBlockText" 
                       Text="" 
                       Foreground="Red" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Left"/>
            
            <Button x:Name="SubmitOrderButton" 
                    Content="СОХРАНИТЬ ЧЕРНОВИК ЗАКАЗА (СТАТУС: СОЗДАН)" 
                    Background="#2A5C91" 
                    Foreground="White" 
                    Height="50" 
                    HorizontalAlignment="Stretch" 
                    VerticalContentAlignment="Center" 
                    HorizontalContentAlignment="Center" 
                    FontSize="14" 
                    FontWeight="Bold"/>
        </StackPanel>

    </Grid>
</UserControl>


    
