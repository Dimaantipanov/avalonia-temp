<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="FenceFactory.Desktop.Views.Manager.Parts.Templates.FastenerMaterialPanel">
    <!-- Главный контейнер плавно масштабируется по ширине экрана менеджера -->
    <StackPanel Spacing="20" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="20,10,20,0">
        
        <TextBlock Text="ПАРАМЕТРЫ КРЕПЕЖА (САМОРЕЗЫ)" 
                   FontWeight="Bold" 
                   FontSize="16" 
                   Foreground="#E4E4E7"
                   Margin="0,0,0,10"/>

        <!-- 1. Длина самореза в мм -->
        <StackPanel Spacing="8">
            <Label Content="Длина самореза по металлу (в мм, например 19 или 29):" Foreground="#A1A1AA" FontSize="13"/>
            <NumericUpDown x:Name="FastenerLengthInput" 
                           HorizontalAlignment="Stretch" 
                           Height="40"
                           Minimum="1" 
                           Value="19"
                           FormatString="0"/>
            <TextBlock Text="*Стандартный кровельный саморез для профлиста обычно имеет длину 19 мм" FontSize="11" Foreground="#71717A" Margin="2,0,0,0"/>
        </StackPanel>

        <!-- Информационная плашка с будущим SKU для Крепежа -->
        <Border Background="#27272A" CornerRadius="6" Padding="15" Margin="0,15,0,0" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="Будет создан системный номенклатурный артикул (SKU):" Foreground="#A1A1AA" VerticalAlignment="Center" FontSize="13"/>
                <TextBlock Grid.Column="1" x:Name="FastenerSkuPreviewText" Text="FST-19" FontWeight="Black" Foreground="#10B981" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
        </Border>
        
    </StackPanel>

</UserControl>
